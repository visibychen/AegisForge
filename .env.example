# Copy with: conda run -n AegisForge python scripts/dev.py init
# Never put secrets in VITE_* variables or commit the generated .env.
AEGISFORGE_API_TOKEN=
AEGISFORGE_MODEL_MODE=fake
# JSON array; default dev ports only. Add a trusted preview origin if necessary.
AEGISFORGE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
