      "candidate_source": "import sqlite3\n\nfrom flask import Flask, request\n\napp = Flask(__name__)\n\n\n@app.patch(\"/users/<int:user_id>\")\ndef update_user(user_id):\n    changes = request.get_json(force=True)\n    db = sqlite3.connect(\"app.db\")\n    valid_columns = {row[1] for row in db.execute(\"PRAGMA table_info(users)\")}\n    assignments = []\n    values = []\n    for column, value in changes.items():\n        if column not in valid_columns:\n            db.close()\n            return {\"error\": f\"invalid column: {column}\"}, 400\n        assignments.append(f'\"{column}\" = ?')\n        values.append(value)\n    values.append(user_id)\n    db.execute(f\"UPDATE users SET {', '.join(assignments)} WHERE id = ?\", tuple(values))\n    db.commit()\n    return {\"updated\": user_id}\n"
    }
